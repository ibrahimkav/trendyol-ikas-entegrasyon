# ÖRNEK yapılandırma — GERÇEK ANAHTAR YAZMAYIN (bu dosya git'e dahildir).
# Trendyol anahtarları uygulamada Ayarlar → Trendyol Bağlantısı'ndan mağaza bazında
# şifreli saklanır; buradaki TRENDYOL_* değerleri boş bırakılmalıdır.
# Trendyol API
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
TRENDYOL_SUPPLIER_ID=

# Groq API (ÜCRETSİZ ve HIZLI)
# Kayıt: https://console.groq.com/
GROQ_API_KEY=

# Database
DATABASE_URL=sqlite:///./trendyol.db

# App Settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# Auth (Wave 1 — email-OTP + JWT)
# JWT_SECRET boşsa SECRET_KEY kullanılır; production'da ayrı, rastgele üretilmiş bir değer verin.
JWT_SECRET=
# Mağaza API kimlik bilgilerini (Trendyol/Hepsiburada key+secret) şifrelemek için kullanılan
# Fernet anahtarı. Boşsa SECRET_KEY'den türetilir (dev fallback) — production'da MUTLAKA
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# ile üretilmiş ayrı bir değer girin.
CREDENTIAL_ENCRYPTION_KEY=
# Telefon/LAN'dan erişim için ek CORS origin'leri (virgülle ayrılmış), ör:
# CORS_ORIGINS=http://192.168.1.23:5173
CORS_ORIGINS=



# ikas kargo entegrasyon tokeni (gercek deger backend/.env icinde, buraya YAZILMAZ)
IKAS_CARGO_INTEGRATION_TOKEN=your_ikas_cargo_integration_token_here
