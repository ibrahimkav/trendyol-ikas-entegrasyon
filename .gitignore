# .env YEDEKLERI -- canli Trendyol/ikas anahtarlari, JWT ve
# sifreleme anahtarlari. Ustteki ".env" kurali bunlari KAPSAMIYOR.
.env.bak*
.env.*.bak*
*.env.bak*

# VERITABANI YEDEKLERI -- gercek musteri adi/adresi/telefonu ve
# siparis gecmisi. Ustteki "*.db" kurali .db.bak-* uzantisini
# KAPSAMIYOR (bu yuzden ayrica yaziliyor).
*.db.bak*
*.db-wal
*.db-shm
*.sqlite3

